{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "s3:ListBucket",
        "s3:GetReplicationConfiguration",
        "s3:GetObjectVersionForReplication",
        "s3:GetObjectVersionAcl",
        "s3:GetObjectVersionTagging",
        "s3:GetObjectRetention",
        "s3:GetObjectLegalHold"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::${BUCKET_A}",
        "arn:aws:s3:::${BUCKET_A}/*",
        "arn:aws:s3:::${BUCKET_B}",
        "arn:aws:s3:::${BUCKET_B}/*"
      ]
    },
    {
      "Action": [
        "s3:ReplicateObject",
        "s3:ReplicateDelete",
        "s3:ReplicateTags"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::${BUCKET_A}/*",
        "arn:aws:s3:::${BUCKET_B}/*"
      ]
    }
  ]
}
